[Unit]
Description=MIT App Inventor (App Engine dev server)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=/opt/appinventor
Environment=JAVA_HOME=@JAVA_HOME@
Environment=PATH=@JAVA_HOME@/bin:/usr/local/bin:/usr/bin:/bin
# Only the collaboration hub is exposed to the network; App Inventor listens on the Pi only.
ExecStart=/opt/google-cloud-sdk/bin/java_dev_appserver.sh --port=8888 --address=127.0.0.1 --disable_update_check --jvm_flag=-Xms768m --jvm_flag=-Xmx1536m --jvm_flag=-Ddatastore.store_delay=120000 /opt/appinventor/war
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
